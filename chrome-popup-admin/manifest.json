{
  "manifest_version": 3,
  "name": "OpenAIRouter Admin",
  "version": "1.0.0",
  "description": "Popup admin panel for local OpenAIRouter config management.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://localhost:3100/*",
    "http://127.0.0.1:3100/*"
  ],
  "action": {
    "default_title": "OpenAIRouter Admin",
    "default_popup": "popup.html"
  }
}
